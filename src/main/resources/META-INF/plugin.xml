<idea-plugin url="https://github.com/getomni/jetbrains">

    <id>com.github.getomni.jetbrains</id>

    <name>Omni Theme</name>

    <vendor
            email="maycon.s.santos44@gmail.com"
            url="https://github.com/getomni">
        Omni Theme
    </vendor>

    <description><![CDATA[
        <p>Omni Theme is a dark theme inspired by the original Omni design, bringing a clean and comfortable coding experience to JetBrains IDEs.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.MyBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <themeProvider
                id="4cdf8912-6063-4823-b4aa-54024f8c94a4"
                path="/Omni.theme.json"/>
    </extensions>

</idea-plugin>